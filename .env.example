# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy to .env / .env.production / .env.staging / .env.local and fill in values.
# NEVER commit real credentials - the real .env.* files are gitignored.
# ==============================================================================
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

PROD_PORT=9443
STAGING_PORT=9442
REDIS_PORT=9379
PGBOUNCER_PORT=9432
PROMETHEUS_PORT=9191
GRAFANA_PORT=9292

# Redis Cache & Distributed Rate Limiter
REDIS_URL=redis://127.0.0.1:9379

# WebAuthn / Passkeys Configuration
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:8080

# Remote PostgreSQL Database (no local DB container)
DB_USER=change_me
DB_PASSWORD=change_me
DB_HOST=db.example.com
DB_PORT=5432
DB_NAME=interview_staging
DB_SSLMODE=require
DATABASE_URL=postgresql://change_me:change_me@db.example.com:5432/interview_staging?sslmode=require

DB_POOL_MIN=5
DB_POOL_MAX=25

# Application Configuration
APP_NAME=InterviewGuidePlatform
APP_URL=http://localhost:9443
CORS_ORIGIN=http://localhost:9443

# Observability (Prometheus / Grafana)
METRICS_PORT=9191
PROMETHEUS_ENABLED=true
LOG_LEVEL=info
