{
  "openapi": "3.0.3",
  "info": {
    "title": "Interview Guide Platform API",
    "description": "High-performance Rust Axum RESTful API providing category navigation, questions querying, full-text search, mock interview quiz generation, SM-2 spaced repetition, and bookmarks.",
    "version": "2.0.0",
    "contact": {
      "name": "Platform Engineering",
      "url": "https://github.com/sgdevmane/interview-guide"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080/api",
      "description": "Local Rust Backend Server"
    },
    {
      "url": "https://staging-interview.company.internal/api",
      "description": "Staging Server"
    },
    {
      "url": "https://interview.company.com/api",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/categories": {
      "get": {
        "summary": "List all 55 interview categories",
        "tags": ["Categories"],
        "responses": {
          "200": {
            "description": "Array of 55 categories with question counts and descriptions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Category" }
                }
              }
            }
          }
        }
      }
    },
    "/categories/{categoryId}": {
      "get": {
        "summary": "Get category metadata",
        "tags": ["Categories"],
        "parameters": [
          { "name": "categoryId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Category details",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Category" } }
            }
          }
        }
      }
    },
    "/categories/{categoryId}/questions": {
      "get": {
        "summary": "Get questions for a category",
        "tags": ["Questions"],
        "parameters": [
          { "name": "categoryId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "difficulty", "in": "query", "required": false, "schema": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced"] } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "default": 100 } }
        ],
        "responses": {
          "200": {
            "description": "List of questions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Question" }
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Global cross-category full-text search",
        "tags": ["Search"],
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Search results matching query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SearchResult" }
                }
              }
            }
          }
        }
      }
    },
    "/quiz/generate": {
      "get": {
        "summary": "Generate timed mock interview quiz",
        "tags": ["Quiz"],
        "parameters": [
          { "name": "category_id", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "count", "in": "query", "required": false, "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Quiz session with questions and options",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/QuizSession" } }
            }
          }
        }
      }
    },
    "/quiz/submit": {
      "post": {
        "summary": "Submit quiz evaluation",
        "tags": ["Quiz"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/QuizSubmission" } }
          }
        },
        "responses": {
          "200": {
            "description": "Quiz score and evaluation",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/QuizResult" } }
            }
          }
        }
      }
    },
    "/progress/review": {
      "post": {
        "summary": "Record SM-2 spaced repetition review",
        "tags": ["Spaced Repetition"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SpacedRepetitionReviewRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "Calculated next review interval",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SpacedRepetitionItem" } }
            }
          }
        }
      }
    },
    "/bookmarks": {
      "get": {
        "summary": "List all saved bookmarks",
        "tags": ["Bookmarks"],
        "responses": {
          "200": {
            "description": "Array of bookmarks",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/BookmarkItem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Toggle bookmark on question",
        "tags": ["Bookmarks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BookmarkRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Bookmark removed" },
          "201": { "description": "Bookmark added" }
        }
      }
    },
    "/notes": {
      "get": {
        "summary": "List all candidate notes",
        "tags": ["Notes"],
        "responses": {
          "200": {
            "description": "Array of notes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/NoteItem" }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save or update question note",
        "tags": ["Notes"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/NoteRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Note updated" },
          "201": { "description": "Note created" }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Prometheus text metrics",
        "tags": ["Observability"],
        "responses": {
          "200": { "description": "Prometheus scrape endpoint", "content": { "text/plain": {} } }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "tags": ["Observability"],
        "responses": {
          "200": { "description": "Service is healthy" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "javascript" },
          "name": { "type": "string", "example": "JavaScript" },
          "description": { "type": "string" },
          "icon_path": { "type": "string" },
          "total_questions": { "type": "integer", "example": 100 }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "title": { "type": "string" },
          "difficulty": { "type": "string" },
          "strategy": { "type": "string" },
          "answer_markdown": { "type": "string" },
          "code_example": { "type": "string" }
        }
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "question": { "$ref": "#/components/schemas/Question" },
          "match_field": { "type": "string" },
          "score": { "type": "number" }
        }
      },
      "QuizSession": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" },
          "category_id": { "type": "string" },
          "duration_minutes": { "type": "integer" },
          "total_questions": { "type": "integer" },
          "questions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/QuizQuestion" }
          }
        }
      },
      "QuizQuestion": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "prompt": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "correct_option_index": { "type": "integer" },
          "explanation": { "type": "string" }
        }
      },
      "QuizSubmission": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" },
          "answers": { "type": "array", "items": { "type": "integer" } }
        }
      },
      "QuizResult": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" },
          "total_questions": { "type": "integer" },
          "correct_answers": { "type": "integer" },
          "score_percentage": { "type": "number" },
          "passed": { "type": "boolean" }
        }
      },
      "SpacedRepetitionReviewRequest": {
        "type": "object",
        "properties": {
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "rating": { "type": "integer", "description": "1=Again, 2=Hard, 3=Good, 4=Easy" }
        },
        "required": ["category_id", "question_number", "rating"]
      },
      "SpacedRepetitionItem": {
        "type": "object",
        "properties": {
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "interval_days": { "type": "integer" },
          "repetitions": { "type": "integer" },
          "ease_factor": { "type": "number" },
          "next_review": { "type": "string", "format": "date-time" },
          "status": { "type": "string" }
        }
      },
      "BookmarkRequest": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" }
        },
        "required": ["category_id", "question_number"]
      },
      "BookmarkItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "NoteRequest": {
        "type": "object",
        "properties": {
          "user_id": { "type": "string" },
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "note_content": { "type": "string" }
        },
        "required": ["category_id", "question_number", "note_content"]
      },
      "NoteItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "category_id": { "type": "string" },
          "question_number": { "type": "integer" },
          "note_content": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
