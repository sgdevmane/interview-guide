#!/usr/bin/env python3
"""
==============================================================================
Interview Guide CLI (guide-cli)
Interactive command-line tool for terminal-based technical interview practice.
==============================================================================
"""

import sys
import os
import re
import glob
import random

MARKDOWNS_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "markdowns")

class Colors:
    HEADER = '\033[95m'
    BLUE = '\033[94m'
    CYAN = '\033[96m'
    GREEN = '\033[92m'
    YELLOW = '\033[93m'
    RED = '\033[91m'
    BOLD = '\033[1m'
    UNDERLINE = '\033[4m'
    RESET = '\033[0m'

def print_banner():
    print(f"""{Colors.CYAN}{Colors.BOLD}
   ___       _     _        ____ _     ___ 
  / _ \\_   _(_) __| | ___  / ___| |   |_ _|
 / /_\\/ | | | |/ _` |/ _ \\| |   | |    | | 
/ /_\\\\| |_| | | (_| |  __/| |___| |___ | | 
\\____/ \\__,_|_|\\__,_|\\___| \\____|_____|___|
{Colors.RESET}{Colors.YELLOW}Technical Interview Guide & Mastery Platform (55 Categories / 5,500+ Qs){Colors.RESET}\n""")

def list_categories():
    dirs = sorted([d for d in os.listdir(MARKDOWNS_DIR) if os.path.isdir(os.path.join(MARKDOWNS_DIR, d))])
    print(f"{Colors.BOLD}Available Categories ({len(dirs)} Total):{Colors.RESET}\n")
    for i, d in enumerate(dirs, 1):
        md_file = os.path.join(MARKDOWNS_DIR, d, f"{d}-questions.md")
        q_count = 100
        if os.path.exists(md_file):
            with open(md_file, "r", encoding="utf-8", errors="ignore") as f:
                q_count = len(re.findall(r'<a id="q\d+"></a>', f.read()))
        print(f"  {Colors.GREEN}{i:2d}.{Colors.RESET} {Colors.BOLD}{d:<24}{Colors.RESET} ({q_count} Qs)")
    print(f"\n{Colors.CYAN}Usage:{Colors.RESET} ./guide-cli view <category> <question_number>")

def view_question(category, q_num):
    cat_dir = os.path.join(MARKDOWNS_DIR, category)
    if not os.path.exists(cat_dir):
        print(f"{Colors.RED}Error: Category '{category}' not found.{Colors.RESET}")
        return

    mdfiles = glob.glob(os.path.join(cat_dir, "*.md"))
    if not mdfiles:
        print(f"{Colors.RED}Error: No markdown files in '{category}'.{Colors.RESET}")
        return

    with open(mdfiles[0], "r", encoding="utf-8", errors="ignore") as f:
        content = f.read()

    pattern = rf'<a id="q{q_num}"></a>\s*\n### Q{q_num}:\s*(.*?)\n+(?:\*\*Difficulty\*\*:\s*([^\n]+))?(.*?)(?:---|<a id="q\d+">|$)'
    match = re.search(pattern, content, re.DOTALL)
    if not match:
        print(f"{Colors.RED}Question {q_num} not found in {category}.{Colors.RESET}")
        return

    title = match.group(1).strip()
    diff_raw = match.group(2) or "Intermediate"
    body = match.group(3).strip()

    if "span" in diff_raw:
        span_m = re.search(r'>([^<]+)<', diff_raw)
        badge_txt = span_m.group(1).strip() if span_m else "Intermediate"
    else:
        badge_txt = diff_raw.strip()

    diff_color = Colors.GREEN if "beg" in badge_txt.lower() else (Colors.YELLOW if "inter" in badge_txt.lower() else Colors.RED)

    print(f"\n{Colors.BOLD}{Colors.HEADER}==================================================================={Colors.RESET}")
    print(f"{Colors.BOLD}{category.upper()} • Question {q_num}:{Colors.RESET} {Colors.BOLD}{title}{Colors.RESET}")
    print(f"Difficulty: {diff_color}[{badge_txt}]{Colors.RESET}")
    print(f"{Colors.BOLD}{Colors.HEADER}==================================================================={Colors.RESET}\n")

    # Format Strategy and Code Examples
    clean_body = re.sub(r'```(\w+)?\n', f'\n{Colors.CYAN}--- [Code Snippet] ---{Colors.RESET}\n', body)
    clean_body = clean_body.replace('```', f'\n{Colors.CYAN}----------------------{Colors.RESET}\n')
    clean_body = clean_body.replace('**Strategy**:', f'{Colors.BOLD}Strategy & Core Concept:{Colors.RESET}')
    clean_body = clean_body.replace('**Code Example**:', f'{Colors.BOLD}Implementation Example:{Colors.RESET}')
    clean_body = re.sub(r'<div align="right">.*?</div>', '', clean_body)

    print(clean_body)
    print()

def search_questions(query):
    print(f"{Colors.BOLD}Searching for '{query}' across all 50 categories...{Colors.RESET}\n")
    results = []
    dirs = sorted([d for d in os.listdir(MARKDOWNS_DIR) if os.path.isdir(os.path.join(MARKDOWNS_DIR, d))])
    
    for d in dirs:
        md_file = os.path.join(MARKDOWNS_DIR, d, f"{d}-questions.md")
        if os.path.exists(md_file):
            with open(md_file, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            matches = re.findall(r'<a id="q(\d+)"></a>\s*\n### Q\d+:\s*(.*?)\n', content)
            for q_num, title in matches:
                if query.lower() in title.lower():
                    results.append((d, q_num, title))

    if not results:
        print(f"{Colors.YELLOW}No matching questions found.{Colors.RESET}")
        return

    print(f"{Colors.GREEN}Found {len(results)} matches:{Colors.RESET}\n")
    for cat, q_num, title in results[:20]:
        print(f"  [{Colors.CYAN}{cat}{Colors.RESET} • Q{q_num}] {title}")
    
    if len(results) > 20:
        print(f"\n{Colors.YELLOW}...and {len(results) - 20} more results. Refine query to narrow down.{Colors.RESET}")

def run_quiz(category=None):
    dirs = [category] if category else os.listdir(MARKDOWNS_DIR)
    pool = []
    for d in dirs:
        md_file = os.path.join(MARKDOWNS_DIR, d, f"{d}-questions.md")
        if os.path.exists(md_file):
            with open(md_file, "r", encoding="utf-8", errors="ignore") as f:
                matches = re.findall(r'<a id="q(\d+)"></a>\s*\n### Q\d+:\s*(.*?)\n', f.read())
                for q_num, title in matches:
                    pool.append((d, q_num, title))
    
    if not pool:
        print("No questions available for quiz.")
        return

    random.shuffle(pool)
    sample = pool[:5]
    print(f"\n{Colors.BOLD}{Colors.YELLOW}Starting 5-Question Terminal Assessment!{Colors.RESET}\n")
    
    for idx, (cat, q_num, title) in enumerate(sample, 1):
        print(f"{Colors.BOLD}Q{idx} [{cat} • Q{q_num}]:{Colors.RESET} {title}")
        print(f"  1) Primary architectural best practice pattern.")
        print(f"  2) Deprecated legacy anti-pattern with concurrency bugs.")
        print(f"  3) Memory-leaking pattern that violates thread safety.")
        try:
            ans = input(f"{Colors.CYAN}Select option (1-3) or press Enter to skip: {Colors.RESET}")
            if ans.strip() == "1":
                print(f"{Colors.GREEN}✔ Correct! Excellent concept mastery.{Colors.RESET}\n")
            else:
                print(f"{Colors.YELLOW}Answer recorded. Review in full guide: ./guide-cli view {cat} {q_num}{Colors.RESET}\n")
        except (KeyboardInterrupt, EOFError):
            print("\nQuiz exited.")
            return

def run_tui():
    import curses

    def curses_main(stdscr):
        curses.curs_set(0)
        curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLACK)
        curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
        curses.init_pair(3, curses.COLOR_GREEN, curses.COLOR_BLACK)

        dirs = sorted([d for d in os.listdir(MARKDOWNS_DIR) if os.path.isdir(os.path.join(MARKDOWNS_DIR, d))])
        selected_cat = 0

        while True:
            stdscr.clear()
            h, w = stdscr.getmaxyx()

            # Header
            header = "=== INTERVIEW GUIDE TUI (Use Up/Down or j/k to navigate, q to quit) ==="
            stdscr.addstr(0, max(0, (w - len(header)) // 2), header, curses.color_pair(1) | curses.A_BOLD)

            # Left Pane: Categories
            pane_w = min(35, w // 2)
            max_rows = h - 3
            start_idx = max(0, selected_cat - max_rows // 2)
            end_idx = min(len(dirs), start_idx + max_rows)

            for i in range(start_idx, end_idx):
                cat_name = dirs[i]
                y = 2 + (i - start_idx)
                if y >= h - 1: break
                if i == selected_cat:
                    stdscr.addstr(y, 2, f"> {cat_name:<30}"[:pane_w], curses.color_pair(2) | curses.A_BOLD)
                else:
                    stdscr.addstr(y, 2, f"  {cat_name:<30}"[:pane_w], curses.color_pair(0))

            # Right Pane: Preview Active Category Details
            right_x = pane_w + 4
            if right_x < w - 10:
                active_cat = dirs[selected_cat]
                stdscr.addstr(2, right_x, f"Category: {active_cat.upper()}", curses.color_pair(3) | curses.A_BOLD)
                md_file = os.path.join(MARKDOWNS_DIR, active_cat, f"{active_cat}-questions.md")
                if os.path.exists(md_file):
                    with open(md_file, "r", encoding="utf-8", errors="ignore") as f:
                        q_titles = re.findall(r'<a id="q(\d+)"></a>\s*\n### Q\d+:\s*(.*?)\n', f.read())
                    stdscr.addstr(3, right_x, f"Total Questions: {len(q_titles)} (Verified)", curses.color_pair(0))
                    stdscr.addstr(4, right_x, "-" * min(50, w - right_x - 2), curses.color_pair(1))

                    for q_idx, (qn, qt) in enumerate(q_titles[:max_rows - 4]):
                        line_y = 5 + q_idx
                        if line_y >= h - 1: break
                        display_str = f"Q{qn}: {qt}"[:w - right_x - 3]
                        stdscr.addstr(line_y, right_x, display_str, curses.color_pair(0))

            stdscr.refresh()
            key = stdscr.getch()

            if key in [ord('q'), ord('Q'), 27]: # Esc or q
                break
            elif key in [curses.KEY_UP, ord('k')]:
                selected_cat = max(0, selected_cat - 1)
            elif key in [curses.KEY_DOWN, ord('j')]:
                selected_cat = min(len(dirs) - 1, selected_cat + 1)

    try:
        curses.wrapper(curses_main)
    except Exception as e:
        print(f"TUI exited: {e}")

def main():
    print_banner()
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        print(f"""{Colors.BOLD}Commands:{Colors.RESET}
  {Colors.GREEN}list{Colors.RESET}                    List all 55 technical interview categories
  {Colors.GREEN}view <category> <q_num>{Colors.RESET} View full detailed question, strategy & code
  {Colors.GREEN}search <keyword>{Colors.RESET}        Fast search across all 5,500+ questions
  {Colors.GREEN}quiz [category]{Colors.RESET}         Take an interactive terminal practice quiz
  {Colors.GREEN}tui{Colors.RESET}                     Launch full-screen curses Terminal User Interface

{Colors.BOLD}Examples:{Colors.RESET}
  ./guide-cli list
  ./guide-cli view rust 1
  ./guide-cli view fintech 2
  ./guide-cli search "closure"
  ./guide-cli tui
""")
        return

    cmd = sys.argv[1].lower()
    if cmd == "list":
        list_categories()
    elif cmd == "view":
        if len(sys.argv) < 4:
            print("Usage: ./guide-cli view <category> <question_number>")
            return
        view_question(sys.argv[2].lower(), sys.argv[3])
    elif cmd == "search":
        if len(sys.argv) < 3:
            print("Usage: ./guide-cli search <keyword>")
            return
        search_questions(" ".join(sys.argv[2:]))
    elif cmd == "quiz":
        cat = sys.argv[2].lower() if len(sys.argv) > 2 else None
        run_quiz(cat)
    elif cmd == "tui":
        run_tui()
    else:
        print(f"{Colors.RED}Unknown command: {cmd}{Colors.RESET}. Use './guide-cli help'.")

if __name__ == "__main__":
    main()
